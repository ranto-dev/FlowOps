# ============================================
# FlowOps Backend Configuration (template)
# ============================================
# Copiez ce fichier en `.env` et remplissez-le avec VOS propres valeurs.
#
# Créer son GitHub OAuth App :
#   1. Allez sur https://github.com/settings/developers
#   2. Cliquez sur "New OAuth App"
#   3. Application name : FlowOps (ou ce que vous voulez)
#   4. Homepage URL     : http://localhost:5173
#   5. Authorization callback URL : http://localhost:5173/auth
#      (obligatoire pour créer l'app ; le Device Flow n'utilise pas cette URL)
#   6. Après création, copiez le Client ID et le Client Secret ci-dessous.

# --- GitHub OAuth (OBLIGATOIRE pour l'authentification) ---
GITHUB_CLIENT_ID=votre_client_id_github
GITHUB_CLIENT_SECRET=votre_client_secret_github

# --- MongoDB ---
# Par défaut : mongodb://localhost:27017/
MONGO_URI=mongodb://localhost:27017/

# --- Token GitHub personnel (OPTIONNEL, utilisé uniquement par github_collector.py) ---
# Ce token sert à l'analyse de données hors-ligne, PAS à l'authentification web.
GITHUB_TOKEN=